# Studbook configuration. Copy to .env and adjust. Never commit .env.

# --- Application ---
APP_URL=https://studbook.example.com
APP_ENV=production            # production | development
APP_DEBUG=false
APP_DEFAULT_LANGUAGE=en       # en | hu (users can change it in Settings)
APP_TIMEZONE=UTC              # used for displaying dates; the database stores UTC
# Link to the source code in the footer (AGPL-3.0 requires offering it to users).
# Point it to your fork if you run a modified version.
APP_SOURCE_URL=https://github.com/Craftzone-IT/studbook
# Comma-separated IPs of reverse proxies (e.g. NPMplus) whose X-Forwarded-For
# header is trusted for the client IP used by login rate limiting. Empty = none.
TRUSTED_PROXIES=
# Protects the browser setup page (/setup) before the first login exists.
# Set a random value of at least 16 characters for the first installation and
# remove it afterwards. Empty = setup page only explains how to enable it.
SETUP_TOKEN=

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studbook
DB_USER=studbook
DB_PASSWORD=change-me

# --- Storage (all git-ignored, must be writable by PHP) ---
STORAGE_PATH=storage
CATALOG_DOWNLOAD_PATH=storage/catalog/rebrickable
BRICKLINK_FILES_PATH=storage/catalog/bricklink   # put your BrickLink catalogue downloads here
IMAGE_CACHE_PATH=storage/images
UPLOAD_PATH=storage/uploads

# --- Catalogue import ---
REBRICKABLE_DOWNLOAD_BASE=https://cdn.rebrickable.com/media/downloads/
IMPORT_MIN_INTERVAL_HOURS=24   # Rebrickable allows at most one automated download per day
IMPORT_SCHEDULE_DAYS=7         # `bin/import --cron` runs a full import when the last one is older than this
# Optional but strongly recommended: your own free Rebrickable API key
# (rebrickable.com → Settings → API). The import then reads the official
# BrickLink id of every part and colour (including printed parts) from the
# API, cached and fetched at most once a day. Empty = match locally against
# your BrickLink files only.
REBRICKABLE_API_KEY=
REBRICKABLE_API_BASE=https://rebrickable.com/api/v3/

# --- Camera features (optional) ---
OCR_ENABLED=false
TESSERACT_BINARY=/usr/bin/tesseract   # needs exec() allowed in PHP for this site
OCR_LANGUAGE=eng                      # Tesseract language model; English is enough for part numbers

BRICKOGNIZE_ENABLED=false
BRICKOGNIZE_API_URL=https://api.brickognize.com
BRICKOGNIZE_TIMEOUT_SECONDS=10
