<?xml version="1.0"?>
<ruleset name="Studbook">
    <description>PSR-12 for Studbook.</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <!-- bin/ scripts have no extension, which phpcs skips; `composer lint` checks them via stdin. -->
    <file>lang</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>
    <rule ref="PSR12"/>
    <!-- Entry points and translation files have side effects by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
    </rule>
    <!-- Translation strings are kept on one line each. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>lang/*</exclude-pattern>
    </rule>
</ruleset>
